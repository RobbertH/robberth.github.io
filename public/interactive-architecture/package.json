{
  "name": "interactive-architecture",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "vite build && cp dist/index.html . && cp -r dist/assets . && rm -rf dist",
    "preview": "vite preview",
    "test": "rm -rf screenshots/*.png && playwright test",
    "test:screenshots": "rm -rf screenshots/*.png && playwright test && echo 'Screenshots saved to screenshots/'"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
